{
  "$schema": "../gen/schemas/desktop-schema.json",
  "productName": "a04-image_viewer-answer",
  "version": "0.1.0",
  "identifier": "com.taurilearn.a04a",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1429",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "练习 A04: 图片查看器（答案）",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
  }
}