{
  "$schema": "../gen/schemas/desktop-schema.json",
  "productName": "e44-csp-answer",
  "version": "0.1.0",
  "identifier": "com.taurilearn.e44a",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1507",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "练习 E44: 内容安全策略（答案）",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
  }
}